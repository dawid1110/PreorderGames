<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <!-- Fioletowy gradient dla akcentów -->
    <linearGradient id="primaryGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#c084fc"/>
      <stop offset="100%" stop-color="#9333ea"/>
    </linearGradient>
  </defs>

  <!-- Tło aplikacji (ciemny motyw) -->
  <rect width="512" height="512" rx="112" fill="#09090b" />
  
  <!-- Subtelny pierścień w tle -->
  <rect x="24" y="24" width="464" height="464" rx="96" fill="none" stroke="url(#primaryGrad)" stroke-width="4" opacity="0.25" />

  <!-- Obudowa Pada -->
  <rect x="80" y="140" width="352" height="232" rx="116" fill="#18181b" stroke="url(#primaryGrad)" stroke-width="16" />
  
  <!-- D-Pad (Krzyżak) -->
  <rect x="144" y="240" width="72" height="24" rx="6" fill="url(#primaryGrad)" />
  <rect x="168" y="216" width="24" height="72" rx="6" fill="url(#primaryGrad)" />
  
  <!-- Przyciski akcji (A, B, X, Y) -->
  <circle cx="356" cy="224" r="14" fill="url(#primaryGrad)" />
  <circle cx="392" cy="252" r="14" fill="url(#primaryGrad)" />
  <circle cx="356" cy="280" r="14" fill="url(#primaryGrad)" />
  <circle cx="320" cy="252" r="14" fill="url(#primaryGrad)" />
</svg>
