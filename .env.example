# Preorder Hub api_v2.py / Turso HTTPS - szablon, BEZ PRAWDZIWYCH SEKRETOW.
# api_v2.py sam nie wczytuje tego pliku. Ustaw zmienne w srodowisku procesu.
# Puste pola wymagane trzeba uzupelnic we wlasnej konfiguracji, nie w repo.

# Wymagane: odrebny losowy sekret JWT, min. 32 bajty.
SECRET_KEY=
# Wymagane: adres bazy HTTPS bez /v2/pipeline, query i danych logowania.
TURSO_DATABASE_URL=
# Wymagane: token konkretnej bazy Turso.
TURSO_AUTH_TOKEN=

ACCESS_TOKEN_EXPIRE_MINUTES=10080
APP_TIMEZONE=Europe/Warsaw
ALLOW_LEGACY_PLAINTEXT_PASSWORDS=false

# Opcjonalne okladki. Stara nazwa TWITCH_CLIENT_PASSWORD jest fallbackiem API v2.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Cron domyslnie wylaczony. Wlaczenie wymaga ponizszych czterech zmiennych
# oraz tabeli utworzonej przez sql/weekly_summary.sql.
# CRON_SECRET musi byc odrebny od SECRET_KEY i miec min.32 losowe bajty.
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# To ID konta w tabeli users PREORDER HUB, nie ID osoby w Telegramie.
TELEGRAM_USER_ID=

# PORT jest dostarczany przez hosting do komendy Uvicorna.
# Wersje Pythona i zaleznosci utrzymuj jawnie po testach.
